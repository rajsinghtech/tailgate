# tailgate-gateway — per-group DaemonSet (privileged). Our entrypoint runs on top
# of the tailscale base image, which supplies tailscaled (kernel TUN), iptables,
# ip6tables, and busybox (mknod/sysctl/ip).
#
# BUILDPLATFORM compiles natively then cross-targets, which is faster than QEMU.
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.26 AS builder
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown

WORKDIR /workspace

# Module files first for layer caching.
COPY go.mod go.sum ./
RUN GOWORK=off go mod download

# Source (filtered by .dockerignore).
COPY . .

# Static binary, no cgo. GOWORK=off keeps the parent go.work out of the build.
RUN GOWORK=off CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a \
    -ldflags "-X main.version=${VERSION} -X main.commit=${COMMIT} -X main.buildDate=${BUILD_DATE}" \
    -o tailgate-gateway ./cmd/tailgate-gateway

# Final stage carries tailscaled + the networking userland the gateway needs.
FROM tailscale/tailscale:v1.98.4
COPY --from=builder /workspace/tailgate-gateway /usr/local/bin/tailgate-gateway
ENTRYPOINT ["/usr/local/bin/tailgate-gateway"]
