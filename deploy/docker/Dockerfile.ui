# tailgate-ui — the management web UI for EgressGroups.
#
# BUILDPLATFORM compiles natively then cross-targets, which is faster than QEMU.
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.26 AS builder
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown

WORKDIR /workspace

COPY go.mod go.sum ./
RUN GOWORK=off go mod download

COPY . .

RUN GOWORK=off CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a \
    -ldflags "-X main.version=${VERSION} -X main.commit=${COMMIT} -X main.buildDate=${BUILD_DATE}" \
    -o tailgate-ui ./cmd/tailgate-ui

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/tailgate-ui /usr/local/bin/tailgate-ui
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/tailgate-ui"]
